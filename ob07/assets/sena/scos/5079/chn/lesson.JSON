: "table", "content": "{\"rows\":\"2\",\"columns\":\"2\",\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"strong\\\">Verbs</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"strong\\\">Expressions</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Go<br/>Go<br/>Continue<br/>Turn<br/>Turn\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"straight (ahead)<br/>straight on ... street<br/>(straight) down ... street<br/>right<br/>left\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Daily Activities"}, {"type": "describer", "content": "Daily activities are things you do almost every day. You use the Present tense to talk about daily activities."}, {"type": "example", "content": "<span class = \"italic\">I have lunch there very often."}, {"type": "example", "content": "<span class = \"italic\">I exercise every day."}, {"type": "example", "content": "<span class = \"italic\">I swim and I go to the gym."}, {"type": "example", "content": "<span class=\"italic\">I walk everywhere."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "swimming pool"}, {"type": "definition", "content": "a place where people can swim"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: There's a swimming pool next to my house."}, {"type": "audio", "content": "engenn2le01ob07aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use to talk about daily activities."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "gym"}, {"type": "definition", "content": "a place people go to exercise"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I exercise every day.  I swim and I go to the gym. "}, {"type": "audio", "content": "engenn2le01ob07aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "bus station"}, {"type": "definition", "content": "the place where a bus leaves and returns"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: There are many bus stations near my home."}, {"type": "audio", "content": "engenn2le01ob07aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "home"}, {"type": "definition", "content": "the place where you live"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: There are many bus stations near my home. "}, {"type": "audio", "content": "engenn2le01ob07aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "house"}, {"type": "definition", "content": "a building where family or small group of people live"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Where is your house?"}, {"type": "audio", "content": "engenn2le01ob07aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "school"}, {"type": "definition", "content": "a place where students go to learn"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The school is close to my house."}, {"type": "audio", "content": "engenn2le01ob07aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "turn right"}, {"type": "definition", "content": "an instruction to move in a different direction"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Go straight on Main Street, then turn right on 5th Street. "}, {"type": "audio", "content": "engenn2le01ob07aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "turn left"}, {"type": "definition", "content": "an instruction to move in a different direction"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Go down this street and then turn left. "}, {"type": "audio", "content": "engenn2le01ob07aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "around the corner"}, {"type": "definition", "content": "on the right side or left side of an intersection of two streets"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: There's a school around the corner."}, {"type": "audio", "content": "engenn2le01ob07aud09"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "go straight"}, {"type": "definition", "content": "move forward in a direct way; do not turn"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Go straight on Main Street."}, {"type": "audio", "content": "engenn2le01ob07aud10"}]}, {"type": "background_image", "content": "engenn2le01ob07re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Find a map of your town or city."}, {"type": "text", "content": "Choose a place on the map."}, {"type": "text", "content": "Give directions to your partner. Don't say the place!"}, {"type": "text", "content": "Ask your partner to find the place."}, {"type": "text", "content": "Change roles."}, {"type": "text", "content": "Repeat the activity with different places."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I choose places on a map."}, {"type": "text", "content": "I give directions."}, {"type": "text", "content": "I listen to directions."}]}], "type": "sena"}