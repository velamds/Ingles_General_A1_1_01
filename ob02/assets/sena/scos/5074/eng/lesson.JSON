tion.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "phone", "type": "name"}, {"content": "device used to talk to someone in a different place", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I want to buy a new phone.", "type": "example"}, {"content": "engenn2le01ob02aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "phone number", "type": "name"}, {"content": "series of numbers used to contact a person in a different place", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: What's your phone number?", "type": "example"}, {"content": "engenn2le01ob02aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "cell", "type": "name"}, {"content": "mobile telephone", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Do you have a cell phone?", "type": "example"}, {"content": "engenn2le01ob02aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "tough", "type": "name"}, {"content": "strict; demanding", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Mr. Edwards is a tough teacher!", "type": "example"}, {"content": "engenn2le01ob02aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "tired", "type": "name"}, {"content": "feeling of need to rest", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I'm tired! I work every weekend.", "type": "example"}, {"content": "engenn2le01ob02aud06", "type": "audio"}]}, {"content": "engenn2le01ob02re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Find a phone directory.", "type": "text"}, {"content": "On one page, practice saying a phone number.", "type": "text"}, {"content": "Ask your partner to identify the number.", "type": "text"}, {"content": "Change roles.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I use numbers 0 - 20.", "type": "text"}, {"content": "I speak clearly.", "type": "text"}, {"content": "I ask about other people's phone numbers. ", "type": "text"}]}], "labs": [{"stimuli": [{"id": 0, "type": "welcome", "contents": [{}], "_data": [], "template_override": 1}, {"id": 1, "contents": [{"value": {"audiosrc": "engenn2le01ob02re2aud01", "images": [{"image": "engenn2le01ob02re2img05.jpg", "id": 0, "text": "", "time": "0"}, {"image": "engenn2le01ob02re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Sally</span>: Hello, I'm Sally! </br>\n<span class=\"strong\">John</span>: Hi, nice to meet you. I'm John. How's it going?", "time": "100"}, {"image": "engenn2le01ob02re2img05.jpg", "id": 2, "text": "<span class=\"strong\">Sally</span>: I'm tired. </br>\n<span class=\"strong\">John</span>: Who is your teacher?", "time": "8000"}, {"image": "engenn2le01ob02re2img05.jpg", "id": 3, "text": "<span class=\"strong\">Sally</span>: Mr. Edwards. He's tough! </br>\n<span class=\"strong\">John</span>: That's true, but he's a good teacher. Are you a new student?", "time": "11000"}, {"image": "engenn2le01ob02re2img05.jpg", "id": 4, "text": "<span class=\"strong\">Sally</span>: Yes I am. Do you want to study together?</br>\n<span class=\"strong\">John</span>: Sure, that's a great idea.", "time": "19750"}, {"image": "engenn2le01ob02re2img06.jpg", "id": 5, "text": "<span class=\"strong\">Sally</span>: My phone number is 208-555-6163. </br>\n<span class=\"strong\">John</span>: 208-555-6162.", "time": "26000"}, {"image": "engenn2le01ob02re2img06.jpg", "id": 6, "text": "<span class=\"strong\">Sally</span>: No, it isn't 6162, it's 6163.</br>\n<span class=\"strong\">John</span>:  Got it.", "time": "38350"}, {"image": "engenn2le01ob02re2img06.jpg", "id": 7, "text": "<span class=\"strong\">Sally</span>: Where do you live?</br>\n<span class=\"strong\">John</span>: I live at 15 Sommer Street, that's s