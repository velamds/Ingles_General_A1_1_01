escriber"}, {"content": "{\"rows\":8,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Pronoun\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Possessive Adjective (Singular)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"my\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"italic\\\">My card is red.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"your\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"italic\\\">Your house is beautiful.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"He\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"his\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"italic\\\">His computer is new.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"She\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"her\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"italic\\\">Her hair is short.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"its\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"italic\\\">Its fur is brown.</span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "Possessive Adjectives go before nouns.", "type": "text"}, {"content": "<span class = \"italic\">Please keep your office neat.</span>", "type": "example"}, {"content": "Note: <span class = \"strong\">Its</span> is a possessive adjective.", "type": "text"}, {"content": "<span class = \"italic\">The cat's tail is long. --> Its tail is long.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Imperatives", "type": "heading"}, {"content": "You use the Imperative to give orders, instructions and warnings.<br/><br/><span class = \"underline\">Please note:</span><br/>With the Imperative, you do not use a subject.<br/><br/><span class = \"underline\">Example:</span><br/><span class = \"underline\">You wash</span> the dishes. \u2718      => Wash the dishes. \u2713 <br/><br/> You use the infinitive form (no \"to\").<br/><br/><span class = \"underline\">Example:</span><br/><span class = \"underline\">To come</span> in please. \u2718   => Come in please. \u2713", "type": "describer"}, {"content": "Finish your vegetables.", "type": "example"}, {"content": "Wash your plate.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "to like to", "type": "name"}, {"content": "to enjoy", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I like to visit the bookstore.", "type": "example"}, {"content": "engenn2le01ob08aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use in a blog.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to hate", "type": "name"}, {"content": "to strongly dislike", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I hate going to the library.", "type": "example"}, {"content": "engenn2le01ob08aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to love", "type": "name"}, {"content": "to strongly like", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I love learning English.", "type": "example"}, {"content": "engenn2le01ob08aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to travel", "type": "name"}, {"content": "to move from one place to another", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I like to travel.", "type": "example"}, {"content": "engenn2le01ob08aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "bookstore", "type": "name"}, {"content": "a place to buy books", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I find new books at the bookstore.", "type": "example"}, {"content": "engenn2le01ob08aud05", "type": "audio"}]}, {"content": "engenn2le01ob08re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Decide on a topic.", "type": "text"}, {"content": "Write a blog.", "type": "text"}, {"content": "Share with a partner.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write a blog about something I like.", "type": "text"}, {"content": "I use correct spelling and grammar when I write about personal interests.", "type": "text"}, {"content": "I share my interests with a partner.", "type": "text"}]}], "labs": [{"stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "id": 0, "template_override": 1}, {"id": 1, "contents": [{"value": {"audiosrc": "engenn2le01ob08re2aud01", "images": [{"image": "engenn2le01ob08re2img01.jpg", "id": 0, "text": "", "time": "0"}, {"image": "engenn2le01ob08re2img01.jpg", "id": 1, "text": "<span class=\"strong notdialogue\"> Blog: Travel the World With Sally</span>", "time": "100"}, {"image": "engenn2le01ob08re2img01.jpg", "id": 2, "text": "Welcome to my life!<br/>\nThis is my blog.", "time": "3500"}, {"image": "engenn2le01ob08re2img05.jpg", "id": 3, "text": "My name is Sally. I am from Cambridge, Massachusetts. <br/>\nI love languages! I am learning Spanish at night.<br/>\nI go to the bookstore near the coffee shop with my friends but I hate libraries. They are so boring!", "time": "9000"}, {"image": "engenn2le01ob08re2img03.jpg", "id": 4, "text": "I go to yoga on Mondays and Wednesdays. Natalie's sister does yoga too!  It is fun.", "time": "28000"}, {"image": "engenn2le01ob08re2img02.jpg", "id": 5, "text": "I like to write about places, cities, and food.<br/>\nI also like to travel to new places and meet new people.", "time": "36500"}, {"image": "engenn2le01ob08re2img01.jpg", "id": 6, "text": "Travel  the world with me. Read my blog.<br/>\nE-mail me your comments and ideas.<br/>Happy reading!", "time": "46500"}], "coverimg": "engenn2le01ob08re2img01.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "title": ""}, {"id": 2, "contents": [{"value": {"images": [{"image": "", "id": 0, "text": "&bull; What is a blog?", "time": "7500"}, {"image": "", "id": 1, "text": "&bull; How do you write a blog?", "time": "31000"}, {"image": "", "id": 2, "text": "&bull; Remember!", "time": "85000"}], "video_src": "engenn2le01ob08re3vid01"}, "type": "video"}], "template_override": 1, "_data": [], "type": "video", "title": ""}], "exercises": [{"id": 0, "template_override": 1, "stimuli_ids": [0], "_data": [{"type": "instructions", "contents": [{"content": "I can write a simple blog.", "type": "Learning Outcomes"}, {"content": "I can give basic instructions.", "type": "Learning Outcomes"}, {"content": "I can express possession.", "type": "Learning Outcomes"}, {"content": "Do you read blogs? ", "type": "Free Header Item"}, {"content": "Which blogs do you like or dislike? ", "type": "Free Header Item"}]}, {"type": "group", "contents": [{"content": "Welcome", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct", "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "allowed_attempts": 2}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": "Writing Spot: Sally likes to travel and loves learning Spanish! Let's read about it on her blog!", "type": "free_type_text_area"}], "type": "WLC", "img_path": "", "questions": []}, {"